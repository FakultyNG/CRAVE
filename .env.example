# PostgreSQL. Use a direct connection for migrations and a pooled URL at runtime if your host provides both.
DATABASE_URL="postgresql://crave:change-me@localhost:5432/crave"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-characters"
OTP_PEPPER="replace-with-a-separate-random-secret"

# Strowallet is server-only. Leave blank to use the labelled development OTP provider.
STROWALLET_PUBLIC_KEY=""
STROWALLET_BASE_URL="https://strowallet.com/api"

# Use "mock" only for local development. Production rejects mock payments.
# Set to "strowallet" with a valid public key to enable live checkout.
PAYMENT_PROVIDER="mock"
STROWALLET_PAYMENT_BASE_URL="https://strowallet.com"

# Owner payouts. Mock is development-only; live transfers require explicit finance approval.
PAYOUT_PROVIDER="mock"
STROWALLET_TRANSFER_MODE="sandbox"
# Generate a distinct high-entropy value; used to encrypt stored bank account numbers.
FINANCIAL_DATA_KEY="replace-with-a-separate-random-secret"
# Development-only switch for testing the form outside month-end. Ignored in production.
ALLOW_EARLY_WITHDRAWALS="false"

# Vercel Blob token for admin image/video uploads. Keep server-only.
BLOB_READ_WRITE_TOKEN=""

# Explicitly enable test OTP responses outside production.
AUTH_MOCK_OTP="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Explicitly opt into isolated demo records only on a disposable non-production database.
ALLOW_DEMO_SEED="false"

# Supply only while running the one-time db:bootstrap-admin command.
BOOTSTRAP_ADMIN_PHONE=""
BOOTSTRAP_ADMIN_PIN=""
BOOTSTRAP_ADMIN_NAME="Super Admin"

# External certificate-authority HTTP validation. Remove after validation completes.
PKI_VALIDATION_FILENAME=""
PKI_VALIDATION_CONTENT_BASE64=""
